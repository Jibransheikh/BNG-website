# Cloudflare Workers response headers for bonganagava.com
#
# Ported from .htaccess (Apache/LiteSpeed). Both files must stay in sync: .htaccess
# serves the Apache origin, this serves the Cloudflare deploy. Change one, change
# both.
#
# Cloudflare parses this file and does not serve it as a page.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdnjs.cloudflare.com https://code.jquery.com https://cdn.datatables.net https://script.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.datatables.net; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://script.google.com; frame-src https://www.youtube.com https://docs.google.com; base-uri 'self'; form-action 'self'; object-src 'none'

# Cache lifetimes are deliberately short because asset filenames are NOT
# fingerprinted: warriors.js keeps the same URL across deploys and changes often,
# and movement-NN.jpg is re-encoded in place. A 1 year + immutable policy would
# strand returning visitors on stale JS for a year after each deploy. See the
# matching <FilesMatch> blocks in .htaccess.

/assets/*
  Cache-Control: public, max-age=2592000

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=604800, must-revalidate

/*.css
  Cache-Control: public, max-age=604800, must-revalidate